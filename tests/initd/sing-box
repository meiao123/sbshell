#!/bin/sh /etc/rc.common
# 测试用 sing-box 服务脚本（模拟 OpenWrt 由包管理器提供的 procd 服务）。
START=99
S=${SBSHELL_STUB_STATE:-/tmp/sbshell-stub-state}

start() {
    mkdir -p "$S" 2>/dev/null || true
    if [ ! -s /etc/sing-box/config.json ]; then
        echo "sing-box: no config" >&2
        return 1
    fi
    touch "$S/singbox_active"
    return 0
}

stop() {
    rm -f "$S/singbox_active" 2>/dev/null || true
    # 真机上包管理器的脚本走 ubus 删除实例，没有已注册实例时 rc.common/ubus 会回显两种噪音形态：
    # 短形态 `Command failed: Not found`，以及带命令名的长形态
    # `Command failed: ubus call service delete { "name": "sing-box" } (Not found)`。
    # 默认关闭；各入口的过滤回归测试用 SBSHELL_INITD_NOISE=1 打开。
    if [ "${SBSHELL_INITD_NOISE:-0}" = 1 ]; then
        echo 'Command failed: Not found' >&2
        echo 'Command failed: ubus call service delete { "name": "sing-box" } (Not found)' >&2
    fi
    return 0
}

restart() {
    stop
    start
}

boot() {
    start
}
