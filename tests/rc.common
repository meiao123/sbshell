#!/bin/sh
# 极简 /etc/rc.common，供容器里测试 OpenWrt 风格的 init 脚本：
#   #!/bin/sh /etc/rc.common   形式被执行时，本脚本会收到 <initscript> <action>
initscript="$1"
action="$2"
[ -f "$initscript" ] || { echo "rc.common: missing $initscript" >&2; exit 1; }
# shellcheck disable=SC1090
. "$initscript"
name=$(basename "$initscript")
case "$action" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    boot) if command -v boot >/dev/null 2>&1; then boot; else start; fi ;;
    enable)
        mkdir -p /etc/rc.d
        ln -sf "$initscript" "/etc/rc.d/S${START:-99}${name}"
        exit 0
        ;;
    disable)
        rm -f /etc/rc.d/S*"$name"
        exit 0
        ;;
    enabled)
        [ -e "/etc/rc.d/S${START:-99}${name}" ] && exit 0 || exit 1
        ;;
    *) exit 0 ;;
esac
